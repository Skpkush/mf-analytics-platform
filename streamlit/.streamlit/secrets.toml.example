# Copy to .streamlit/secrets.toml and fill in (NEVER commit the real file).
# On the VPS, point these at your Supabase Session-pooler connection.
# If this file is absent, utils/db.py falls back to the repo .env (LOCAL_DB_*).

[postgres]
host = "localhost"
port = 5432
dbname = "mf_analytics"
user = "postgres"
password = ""

# --- Supabase example (VPS deploy) ---
# [postgres]
# host = "aws-0-ap-south-1.pooler.supabase.com"
# port = 5432
# dbname = "postgres"
# user = "postgres.<project-ref>"
# password = "<your-supabase-password>"
