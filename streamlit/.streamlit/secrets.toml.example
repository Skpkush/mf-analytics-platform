# Copy to .streamlit/secrets.toml and fill in (NEVER commit the real file).
# On the VPS, point these at your Supabase Session-pooler connection.
# If this file is absent, utils/db.py falls back to the repo .env (LOCAL_DB_*).

# utils/db.py accepts either section name ([database] or [postgres]) and either
# key spelling (database/username or dbname/user). Use whichever you prefer.

# Streamlit Community Cloud deploy → Supabase (paste this into the Cloud
# "Secrets" box; use your NEW rotated password — the original was exposed):
[database]
host = "db.quhuvkvitvlmnjpjtvmn.supabase.co"
port = 5432
database = "postgres"
username = "postgres"
password = "YOUR_NEW_ROTATED_SUPABASE_PASSWORD"

# Local dev alternative (PostgreSQL):
# [database]
# host = "localhost"
# port = 5432
# database = "mf_analytics"
# username = "postgres"
# password = "YOUR_LOCAL_DB_PASSWORD"
