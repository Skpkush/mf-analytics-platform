# Copy to .streamlit/secrets.toml and fill in (NEVER commit the real file).
# On the VPS, point these at your Supabase Session-pooler connection.
# If this file is absent, utils/db.py falls back to the repo .env (LOCAL_DB_*).

# Local dev (PostgreSQL)
[postgres]
host = "localhost"
port = 5432
dbname = "mf_analytics"
user = "postgres"
password = "YOUR_LOCAL_DB_PASSWORD"

# --- VPS deploy: point [postgres] at Supabase instead ---
# Use the NEW rotated password (the original was exposed and should be reset).
# Direct connection (IPv6-only on free tier):
#   host = "db.<project-ref>.supabase.co"
# IPv4 Session pooler (use this if the VPS has no IPv6):
#   host = "aws-0-<region>.pooler.supabase.com"
#   user = "postgres.<project-ref>"
# [postgres]
# host = "db.<project-ref>.supabase.co"
# port = 5432
# dbname = "postgres"
# user = "postgres"
# password = "YOUR_NEW_ROTATED_SUPABASE_PASSWORD"
